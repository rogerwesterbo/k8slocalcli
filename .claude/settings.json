{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build:*)",
      "Bash(make build-cli:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make vet:*)",
      "Bash(make fmt:*)",
      "Bash(make gosec:*)",
      "Bash(make govulncheck:*)",
      "Bash(make precheck:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(helm show:*)",
      "Bash(helm template:*)",
      "Bash(helm version:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(kind get:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(./bin/k8slocalcli app list:*)",
      "Bash(./bin/k8slocalcli list:*)",
      "Bash(./bin/k8slocalcli info:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
